{
  "name": "protheus-engineering-agent",
  "version": "0.3.9",
  "description": "Runtime de engenharia baseado em evidências e interface VS Code fina para projetos Protheus ADVPL/TLPP.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "advpl",
    "tlpp",
    "protheus",
    "vscode",
    "mcp",
    "engineering-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danielmontagna86-source/protheus-engineering-agent.git"
  },
  "bugs": {
    "url": "https://github.com/danielmontagna86-source/protheus-engineering-agent/issues"
  },
  "homepage": "https://github.com/danielmontagna86-source/protheus-engineering-agent#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:mutation": "stryker run",
    "test:vscode:host": "node scripts/run-vscode-smoke.mjs",
    "test:vscode:minimum": "node scripts/run-vscode-smoke.mjs --version 1.95.3",
    "test:vscode:tds": "node scripts/run-vscode-smoke.mjs --with-tds",
    "test:vscode:lifecycle": "node scripts/run-vscode-lifecycle.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "build:release": "node scripts/build-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "benchmark": "node benchmark/run.mjs",
    "benchmark:large": "node benchmark/large-repository.mjs ci",
    "benchmark:large:release": "node benchmark/large-repository.mjs release",
    "publication:check": "node scripts/publication-check.mjs",
    "publication:release-check": "npm run verify:release && node scripts/publication-check.mjs --release",
    "validate": "npm run build:extension && node --test --test-concurrency=1 && node scripts/check.mjs && node scripts/publication-check.mjs",
    "validate:release-candidate": "npm run validate && npm run benchmark && npm run smoke && npm run build:release && npm run verify:release && npm run test:vscode:host && npm run test:vscode:minimum && npm run test:vscode:tds && npm audit --audit-level=moderate && npm run test:mutation",
    "doctor": "node packages/runtime/src/cli.mjs doctor",
    "mcp": "node packages/mcp/src/stdio.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "buffer-crc32": "1.0.0",
    "esbuild": "0.28.2",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign": false,
    "keytar": false
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0"
  }
}
