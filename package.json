{
  "name": "protheus-engineering-agent",
  "version": "0.3.0",
  "description": "Open-source engineering runtime and thin VS Code interface for ADVPL/TLPP projects.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "advpl",
    "tlpp",
    "protheus",
    "vscode",
    "mcp",
    "engineering-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danielmontagna86-source/protheus-engineering-agent.git"
  },
  "bugs": {
    "url": "https://github.com/danielmontagna86-source/protheus-engineering-agent/issues"
  },
  "homepage": "https://github.com/danielmontagna86-source/protheus-engineering-agent#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:mutation": "stryker run",
    "test:vscode:host": "node scripts/run-vscode-smoke.mjs",
    "test:vscode:minimum": "node scripts/run-vscode-smoke.mjs --version 1.95.3",
    "test:vscode:tds": "node scripts/run-vscode-smoke.mjs --with-tds",
    "build:extension": "node scripts/build-extension.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "build:release": "node scripts/build-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "benchmark": "node benchmark/run.mjs",
    "publication:check": "node scripts/publication-check.mjs",
    "publication:release-check": "node scripts/publication-check.mjs --release",
    "validate": "node --test && node scripts/check.mjs && node scripts/publication-check.mjs",
    "validate:release-candidate": "npm run validate && npm run smoke && npm run package:extension && npm run test:vscode:host && npm audit --audit-level=high && npm run test:mutation",
    "doctor": "node packages/runtime/src/cli.mjs doctor",
    "mcp": "node packages/mcp/src/stdio.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "adm-zip": "0.6.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign": false,
    "keytar": false
  }
}
