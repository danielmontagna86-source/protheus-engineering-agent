{
  "name": "protheus-engineering-agent",
  "displayName": "Protheus Engineering Agent",
  "description": "Standalone, evidence-backed engineering tools for ADVPL/TLPP projects in VS Code.",
  "version": "0.2.0-alpha.1",
  "publisher": "danielmontagna86-source",
  "private": true,
  "preview": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielmontagna86-source/protheus-engineering-agent.git"
  },
  "bugs": {
    "url": "https://github.com/danielmontagna86-source/protheus-engineering-agent/issues"
  },
  "homepage": "https://github.com/danielmontagna86-source/protheus-engineering-agent#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Linters", "Testing"],
  "keywords": ["advpl", "tlpp", "protheus", "mcp", "engineering"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Open a trusted workspace before allowing an engineering agent to inspect project files."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onCommand:pea.doctor",
    "onCommand:pea.indexWorkspace",
    "onCommand:pea.openContext",
    "onCommand:pea.reviewActiveFile"
  ],
  "contributes": {
    "commands": [
      { "command": "pea.doctor", "title": "Protheus Agent: Doctor" },
      { "command": "pea.indexWorkspace", "title": "Protheus Agent: Index Workspace" },
      { "command": "pea.openContext", "title": "Protheus Agent: Show Engineering Context" },
      { "command": "pea.reviewActiveFile", "title": "Protheus Agent: Review Active ADVPL/TLPP File" }
    ]
  }
}
